          "npc": "villager_taro",
          "actor": [
            "t"
          ],
          "text": "旅人主動問族人：有什麼可以幫忙的？",
          "lines": [
            {
              "who": "@t",
              "zh": "請問有什麼我可以幫忙的嗎？"
            },
            {
              "who": "@npc",
              "zh": "好啊，謝謝你主動問。先幫忙把田埂上的草拔一拔。"
            },
            {
              "who": "@npc",
              "zh": "下次跟著家裡的人一起來田裡，再慢慢學。"
            }
          ],
          "gives": {
            "respect": "learning",
            "toast": [
              "尊重值：學習中",
              "旅人可以跟族人一起體驗潮間帶與水芋田了。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "村民",
        "zh": "芋頭田那邊常有長輩在忙，問問看能不能幫忙吧。"
      },
      "playable": true
    },
