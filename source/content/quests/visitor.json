      "steps": [
        {
          "kind": "spot",
          "spot": "host_tagakal",
          "r": 5,
          "text": "旅人坐上主人家的涼亭，聽長輩說食物的故事",
          "lines": [
            {
              "who": "@host",
              "zh": "來，坐上來，鞋子脫在下面。今天說說吃飯的事。"
            },
            {
              "who": "@host",
              "zh": "以前飛魚季的時候，煮飛魚的鍋子，跟煮別的魚的鍋子是分開的。"
            },
            {
              "who": "@host",
              "zh": "芋頭是女人在田裡顧的，飛魚是男人從海上帶回來的。一頓飯，是全家一起做出來的。"
            },
            {
              "who": "@host",
              "zh": "吃飯的時候，長輩先拿；客人等主人說「吃吧」，再動手。"
            },
            {
              "who": "@t",
              "zh": "我會記住。謝謝您把我當成家裡的人。"
            }
          ],
          "actor": [
            "t"
          ],
          "gives": {
            "respect": "friend",
            "flags": [
              "story_food"
            ],
            "toast": [
              "尊重值：朋友",
              "長輩把旅人當成家裡的朋友了。故事卡「吃飯的事」已寫進手札。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "主人家",
        "zh": "主人家的長輩常在涼亭上休息，旅人可以去坐坐，聽聽以前吃飯的事。"
      },
      "playable": true,
      "review": [
        "飲食故事（煮飛魚的鍋子分開、長輩先取、等主人說「吃吧」）的說法請族人確認"
      ]
    },
