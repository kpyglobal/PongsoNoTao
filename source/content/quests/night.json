      "name": {
        "zh": "涼亭下的夜晚故事",
        "en": ""
      },
      "need": [
        "m",
        "f",
        "t"
      ],
      "review": [
        "黑翅飛魚傳說的公開版本與講述方式"
      ],
      "text": {
        "who": "全隊",
        "coop": "三人一起聽",
        "season": "全年",
        "pre": "Q07",
        "unlock": "故事頁「黑翅飛魚」",
        "kind": "夜晚・故事"
      },
      "req": "Q07",
      "steps": [
        {
          "kind": "spot",
          "spot": "host_tagakal",
          "r": 6,
          "need": [
            "m",
            "f",
            "t"
          ],
          "text": "晚上坐上主人家的涼亭，聽長輩說可以公開的故事",
          "lines": [
            {
              "who": "旁白",
              "zh": "晚上，大家坐上主人家的涼亭，海風吹過來。"
            },
            {
              "who": "@host",
              "zh": "晚上涼快，來坐。今天說一個大家都可以聽的故事。"
            },
            {
              "who": "@host",
              "zh": "很久以前，我們的祖先不懂飛魚，什麼魚都一起煮，結果生病了。"
            },
            {
              "who": "@host",
              "zh": "後來黑翅膀的飛魚來到夢裡，教祖先什麼時候捕、怎麼煮、哪些不能混在一起。"
            },
            {
              "who": "@host",
              "zh": "所以飛魚的規矩不是隨便定的，是飛魚教我們的。"
            },
            {
              "who": "旁白",
              "zh": "這是流傳較廣的版本，各部落說法不同，還要請族人確認。"
            }
          ],
          "gives": {
            "flags": [
              "story_black_wing"
            ],
            "toast": [
              "故事頁",
              "「黑翅飛魚」已寫進手札。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "主人家",
        "zh": "晚上主人家的長輩常在涼亭上乘涼，說不定會說故事。"
      }
    },
