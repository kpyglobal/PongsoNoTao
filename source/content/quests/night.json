          "npc": "elder_f_iratay",
          "need": [
            "m",
            "f",
            "t"
          ],
          "text": "向漁人的女性長輩道謝",
          "lines": [
            {
              "who": "@npc",
              "zh": "吃飽了嗎？地瓜是我們田裡的。下次白天再來幫忙挖。"
            }
          ],
          "gives": {
            "relation": 1,
            "flags": [
              "gathering_done"
            ]
          }
        }
