          "text": "黃昏退潮、天色變暗時，戴頭燈到東清灣潮間帶觀察",
          "lines": [
            {
              "who": "@me",
              "zh": "白天看不到的生物，天一暗就出來了。"
            },
            {
              "who": "旁白",
              "zh": "把燈光壓低，看完就把石頭放回原位。寄居蟹已記進圖鑑。"
            }
          ],
          "gives": {
            "counter": {
              "ecology": 1
            },
