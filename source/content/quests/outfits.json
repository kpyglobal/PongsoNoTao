{
  "file": "outfits",
  "arc": "outfit",
  "note": "族男、族女透過成就＋尋根解鎖傳統服飾；旅人只得到族女縫的小飾品。外來者永遠不穿真正的 Tao 服飾。",
  "quests": [
    {
      "line": "side",
      "roles": [
        "m"
      ],
      "n": 1,
      "playable": true,
      "seasons": [],
      "time": "day",
      "village": null,
      "id": "OF1",
      "arc": "outfit",
      "name": {
        "zh": "尋根：阿公的船組",
        "en": ""
      },
      "giver": "m",
      "review": [
        "族男傳統服飾由誰製作、何時穿著",
        "是否適合在遊戲中日常穿著"
      ],
      "text": {
        "who": "族男",
        "coop": "單人",
        "season": "全年",
        "pre": "M1（跟船組整理過船）",
        "unlock": "族男傳統服飾",
        "kind": "成就＋尋根（M3 出海前）"
      },
      "req": "M1",
      "steps": [
        {
          "kind": "talk",
          "npc": "@host",
          "actor": [
            "m"
          ],
          "text": "主人家長輩提起族男的阿公",
          "lines": [
            {
              "who": "@npc",
              "zh": "你跟船組整理過船了，很快就要第一次出海。你阿公年輕的時候，也是這樣開始的。"
            },
            {
              "who": "@npc",
              "zh": "想知道他的事，去問野銀和椰油的長輩，他們跟他一起出過海。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "elder_ivalino",
          "actor": [
            "m"
          ],
          "text": "野銀的長輩說起阿公出海的樣子",
          "lines": [
            {
              "who": "@npc",
              "zh": "你阿公啊，划船很穩，話不多。分魚的時候，總是先想到別人。"
            },
            {
              "who": "@npc",
              "zh": "記得一個人的名字和他做過的事，就是把他留在家裡。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "elder_yayo",
          "actor": [
            "m"
          ],
          "text": "椰油的長輩說起阿公的船組",
          "lines": [
            {
              "who": "@npc",
              "zh": "我們同一個船組好多年。他補網補得最快，手很巧。"
            },
            {
              "who": "@npc",
              "zh": "回去吧，家裡的長輩有東西要給你。"
            }
          ],
          "gives": {
            "flags": [
              "roots_m_heard"
            ]
          }
        },
        {
          "kind": "talk",
          "npc": "@hostf",
          "actor": [
            "m"
          ],
          "text": "主人家的女性長輩把織好的衣服交給族男",
          "lines": [
            {
              "who": "@npc",
              "zh": "這是家裡的女人一起織的。你要跟船組出海了，也問過阿公的事，可以穿了。"
            },
            {
              "who": "@npc",
              "zh": "出海、祭典、部落的活動，都要穿上它。平常想換回來也可以，要記得是誰織的、是為了什麼。"
            },
            {
              "who": "旁白",
              "zh": "族男解鎖「傳統服飾」，可在手札的「背包」頁換穿。不包含祭儀用的銀盔、金片等物品；穿著的場合還要請族人確認。"
            }
          ],
          "gives": {
            "outfits": [
              "outfit_m_tao"
            ],
            "toast": [
              "解鎖服裝",
              "族男的傳統服飾已加入手札的「背包」頁。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "主人家",
        "zh": "族男跟船組整理過船之後，主人家長輩好像想跟他說說阿公的事。"
      }
    },
    {
      "line": "side",
      "roles": [
        "f"
      ],
      "n": 1,
      "playable": true,
      "seasons": [
        "winter"
      ],
      "time": "day",
      "village": null,
      "id": "OF2",
      "arc": "outfit",
      "name": {
        "zh": "尋根：外婆的織布與水芋田",
        "en": ""
      },
      "giver": "f",
      "review": [
        "族女傳統服飾由誰製作、何時穿著",
        "織布紋樣是否可公開呈現"
      ],
      "text": {
        "who": "族女",
        "coop": "單人",
        "season": "非飛魚季",
        "pre": "J2、IO-F1",
        "unlock": "族女傳統服飾",
        "kind": "成就＋尋根"
      },
      "req": {
        "all": [
          "J2",
          "IO-F1"
        ]
      },
      "steps": [
        {
          "kind": "talk",
          "npc": "weaver_elder",
          "actor": [
            "f"
          ],
          "text": "紅頭的織布長輩說起族女的外婆",
          "lines": [
            {
              "who": "@npc",
              "zh": "你捲線的手勢，跟你外婆一模一樣。她以前常在簷廊織布，一坐就是一個下午。"
            },
            {
              "who": "@npc",
              "zh": "她的水芋田在野銀，去問水芋田長輩吧。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "villager_taro",
          "actor": [
            "f"
          ],
          "text": "野銀的水芋田長輩說起外婆的田",
          "lines": [
            {
              "who": "@npc",
              "zh": "那塊田現在是你家的長輩在照顧。你外婆說過，田要有人走進去，才不會荒掉。"
            },
            {
              "who": "@npc",
              "zh": "去看看吧，回來的時候到家裡的簷廊。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "host_taro",
          "r": 6,
          "actor": [
            "f"
          ],
          "text": "族女走進家裡的水芋田看看",
          "lines": [
            {
              "who": "@f",
              "zh": "原來外婆以前就是在這裡工作。"
            },
            {
              "who": "旁白",
              "zh": "族女在田埂上站了一會兒。"
            }
          ],
          "gives": {
            "flags": [
              "roots_f_field"
            ]
          }
        },
        {
          "kind": "talk",
          "npc": "@hostf",
          "actor": [
            "f"
          ],
          "text": "主人家的女性長輩把織好的衣服交給族女",
          "lines": [
            {
              "who": "@npc",
              "zh": "這件是用家裡的線織的，有一部分還是你外婆留下來的。"
            },
            {
              "who": "@npc",
              "zh": "妳學會處理苧麻、捲線，也走過外婆的田了。穿上它，記得這些手藝是怎麼傳下來的。"
            },
            {
              "who": "旁白",
              "zh": "族女解鎖「傳統服飾」，可在手札的「背包」頁換穿。穿著的場合與紋樣還要請族人確認。"
            }
          ],
          "gives": {
            "outfits": [
              "outfit_f_tao"
            ],
            "toast": [
              "解鎖服裝",
              "族女的傳統服飾已加入手札的「背包」頁。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "紅頭",
        "zh": "紅頭的織布長輩看族女捲線的樣子，好像想起了什麼人。"
      }
    },
    {
      "line": "side",
      "roles": [
        "f",
        "t"
      ],
      "n": 1,
      "playable": true,
      "seasons": [],
      "time": "day",
      "village": "imorod",
      "id": "OF3",
      "arc": "outfit",
      "name": {
        "zh": "族女幫旅人編織草小袋",
        "en": ""
      },
      "need": [
        "f",
        "t"
      ],
      "giver": "f",
      "review": [
        "旅人飾品的樣式（不得是傳統服飾或祭儀紋樣）"
      ],
      "text": {
        "who": "族女＋旅人",
        "coop": "兩人合作",
        "season": "全年",
        "pre": "IT-V2（晚會邀請）、J1",
        "unlock": "旅人的日常小飾品（織草帽、織草小袋）",
        "kind": "支線"
      },
      "req": {
        "all": [
          "IT-V2",
          "J1"
        ]
      },
      "steps": [
        {
          "kind": "talk",
          "npc": "weaver_elder",
          "need": [
            "f",
            "t"
          ],
          "text": "向織布長輩請教：旅人去晚會可以戴什麼",
          "lines": [
            {
              "who": "@npc",
              "zh": "要去漁人的晚會啊？傳統的衣服是族人的，外面來的朋友不穿。"
            },
            {
              "who": "@npc",
              "zh": "不過，讓族女幫你編個小袋子、一頂草帽，帶在身上，這樣就很好。"
            },
            {
              "who": "@npc",
              "zh": "去雜貨店買一捆沒染色的棉線，剩下的我這裡有。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "shop_yayo",
          "actor": [
            "t"
          ],
          "text": "旅人到椰油的雜貨店買棉線",
          "lines": [
            {
              "who": "@npc",
              "zh": "棉線？要編東西啊。這捆是原色的，拿去。"
            }
          ],
          "gives": {
            "items": [
              "cotton_thread"
            ]
          }
        },
        {
          "kind": "talk",
          "npc": "weaver_elder",
          "actor": [
            "f"
          ],
          "text": "族女向織布長輩拿碎布",
          "lines": [
            {
              "who": "@npc",
              "zh": "這些是織剩的線頭和布邊，拿去用。原色、簡單就好，不要照著祭儀的紋樣做。"
            }
          ],
          "gives": {
            "items": [
              "cloth_scrap"
            ]
          }
        },
        {
          "kind": "spot",
          "spot": "host_weave",
          "r": 5,
          "actor": [
            "f"
          ],
          "need": [
            "f",
            "t"
          ],
          "text": "回到簷廊，族女幫旅人編織草小袋與草帽",
          "lines": [
            {
              "who": "@f",
              "zh": "頭低一下，我量一下……好了！一頂草帽，一個小袋子。"
            },
            {
              "who": "@t",
              "zh": "好漂亮！謝謝妳，我會好好珍惜。"
            },
            {
              "who": "旁白",
              "zh": "旅人得到「織草帽」與「織草小袋」。這是日常的小飾品，不是傳統服飾。"
            }
          ],
          "gives": {
            "consume": {
              "cotton_thread": 1,
              "cloth_scrap": 1
            },
            "items": [
              "acc_woven_band",
              "acc_bag_strap"
            ],
            "outfits": [
              "acc_t_band",
              "acc_t_strap"
            ],
            "toast": [
              "新飾品",
              "旅人可以在手札的「背包」頁戴上織草帽、背上織草小袋。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "漁人",
        "zh": "受邀去晚會之後，可以找紅頭的織布長輩，請族女幫旅人編個小飾品。"
      }
    }
  ]
}
