      "steps": [
        {
          "kind": "talk",
          "npc": "harbor_staff",
          "text": "請開元港港務人員教你看潮汐時鐘",
          "lines": [
            {
              "who": "@npc",
              "zh": "出海、下潮間帶前都要先看潮汐。"
            },
            {
              "who": "@npc",
              "zh": "一天大約有兩次退潮。我把潮汐時鐘放在畫面上方，退潮的時候再去潮間帶。"
            }
          ],
          "gives": {
            "flags": [
              "tide_clock"
            ],
            "toast": [
              "潮汐時鐘",
              "畫面上方會顯示漲潮或退潮。現在先簡化成清晨與黃昏退潮。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "租車行老闆",
        "zh": "開元港的港務人員最懂潮汐。"
      },
      "playable": true
    },
