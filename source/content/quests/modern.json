      "steps": [
        {
          "kind": "talk",
          "npc": "culture_worker",
          "text": "問部落文化工作者：族人覺得最重要的現代挑戰是什麼",
          "lines": [
            {
              "who": "@npc",
              "zh": "最重要的挑戰？每個人的答案都不一樣。"
            },
            {
              "who": "@npc",
              "zh": "你們去問問看，不要只聽一個人的。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "elder_iratay",
          "text": "問漁人的長輩",
          "lines": [
            {
              "who": "@npc",
              "zh": "年輕人去台灣工作，部落裡常常只剩老人和小孩。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "teacher_yayo",
          "text": "問族語老師",
          "lines": [
            {
              "who": "@npc",
              "zh": "孩子會說族語的越來越少。語言沒了，很多故事也跟著沒了。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "elder_f_iranmeylek",
          "text": "問東清的女性長輩",
          "lines": [
            {
              "who": "@npc",
              "zh": "海裡的東西，好像沒有以前多了。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "culture_worker",
          "text": "回去告訴部落文化工作者",
          "lines": [
            {
              "who": "@npc",
              "zh": "你們聽到的，都是真的，也都只是一部分。"
            },
            {
              "who": "@npc",
              "zh": "這一頁，要留給族人自己來寫。"
            }
          ],
          "gives": {
            "flags": [
              "modern_challenges"
            ],
            "toast": [
              "現代的挑戰",
              "這一頁留給族人自己來寫。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "朗島",
        "zh": "部落文化工作者說，現代的挑戰要多聽幾個人說。"
      },
      "playable": true,
      "review": [
        "「族人認為最重要的現代挑戰」必須由族人提供；目前三種說法只是常聽到的個人看法（人口外移、族語、漁獲），請族人改寫或替換"
      ]
    },
