      "text": {
        "who": "族男、族女",
        "coop": "選「接手耕作」要雙人：族男＋族女",
        "season": "等待飛魚期",
        "pre": "R3",
        "unlock": "下一年的 R1",
        "kind": ""
      },
      "req": "R3",
      "steps": [
        {
          "kind": "talk",
          "npc": "villager_taro",
          "text": "野銀的水芋田長輩說起一塊荒掉的田",
          "lines": [
            {
              "who": "@npc",
              "zh": "這塊田的主人去台灣工作了，好幾年沒人照顧，草比人還高。"
            },
            {
              "who": "@npc",
              "zh": "你們兩個要不要試試看接手？我會先問過田主人家。"
            }
          ],
          "need": [
            "m",
            "f"
          ]
        },
        {
          "kind": "spot",
          "spot": "taro_ivalino",
          "r": 6,
          "text": "族男清掉田埂上的雜草，族女把水路通開",
          "lines": [
            {
              "who": "@m",
              "zh": "草根好深，一點一點拔。"
            },
            {
              "who": "@f",
              "zh": "水路通了！水又流進田裡了。"
            }
          ],
          "need": [
            "m",
            "f"
          ]
        },
        {
          "kind": "talk",
          "npc": "villager_taro",
          "text": "向水芋田長輩回報",
          "lines": [
            {
              "who": "@npc",
              "zh": "田要有人走進去，才不會荒掉。明年就可以種了。"
            }
          ],
          "need": [
            "m",
            "f"
          ],
          "gives": {
            "flags": [
              "field_takeover"
            ],
            "toast": [
              "接手耕作",
              "明年可以在這塊田重新種下水芋。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "野銀",
        "zh": "野銀的水芋田長輩說，有一塊田荒了好幾年。"
      },
      "playable": true,
      "giver": "f",
      "labourNote": "整地、引水本來是族男的工作（R1），廢耕田的接手由族男、族女一起做",
      "review": [
        "廢耕水芋田的接手是否需要田主人家同意、由誰來談，請族人確認"
      ]
    },
    {
