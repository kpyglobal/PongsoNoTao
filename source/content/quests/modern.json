      ],
      "text": {
        "who": "族人主導，旅人加入",
        "coop": "雙人：族人＋旅人，從兩邊看同一件事",
        "season": "飛魚季前後",
        "pre": "Q05",
        "unlock": "尊重值、部落關係",
        "kind": ""
      },
      "req": "Q05",
      "steps": [
        {
          "kind": "talk",
          "npc": "villager_iranmeylek",
          "text": "東清的族人說起暑假的觀光旺季",
          "lines": [
            {
              "who": "@npc",
              "zh": "暑假的東清，晚上夜市好熱鬧，機車停滿路邊。"
            },
            {
              "who": "@npc",
              "zh": "遊客多，部落的收入多一點；可是灘頭、家門口，也常有人亂走、亂拍。"
            }
          ],
          "need": [
            "t",
            "mf"
          ]
        },
        {
          "kind": "spot",
          "spot": "iranmeylek_beach",
          "r": 8,
          "text": "族人和旅人一起站在東清灣，看同一片海灘",
          "lines": [
            {
              "who": "@me",
              "zh": "對我們來說，這裡是出海的地方，也是家門口。"
            },
            {
              "who": "@t",
              "zh": "對遊客來說，這裡是假期。我是客人，好玩也要記得這裡是別人的家。"
            }
          ],
          "need": [
            "t",
            "mf"
          ]
        },
        {
          "kind": "talk",
          "npc": "pb_couple_f",
          "text": "旅人提醒想坐上拼板舟拍照的情侶遊客",
          "lines": [
            {
              "who": "@t",
              "zh": "不好意思，拼板舟是族人的，不能坐上去拍。在路邊拍海就很漂亮。"
            },
            {
              "who": "@npc",
              "zh": "啊，我們不知道。謝謝你告訴我們！"
            }
          ],
          "need": [
            "t",
            "mf"
          ],
          "gives": {
            "relation": 1,
            "flags": [
              "respect_tourism"
            ],
            "toast": [
              "尊重事件",
              "從兩邊看同一件事：觀光旺季。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "東清",
        "zh": "暑假的東清好熱鬧，東清的族人好像有話想說。"
      },
      "playable": true,
      "review": [
        "觀光旺季對部落的影響（收入與打擾並存）的說法請族人確認"
      ]
    },
