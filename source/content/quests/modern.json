        "pre": "Q05",
        "unlock": "糧倉、部落關係的選擇結果",
        "kind": ""
      },
      "req": "Q05",
      "steps": [
        {
          "kind": "talk",
          "npc": "shop_yayo",
          "text": "到椰油的雜貨店，聽老闆說泡麵",
          "lines": [
            {
              "who": "@npc",
              "zh": "泡麵最好賣了。方便、放得久，船一來就補貨。"
            },
            {
              "who": "@npc",
              "zh": "可是風浪大、船停開的時候，架子一下就空了。"
            }
          ],
          "actor": [
            "m",
            "f"
          ]
        },
        {
          "kind": "talk",
          "npc": "@hostf",
          "text": "回家問女性長輩怎麼看",
          "lines": [
            {
              "who": "@npc",
              "zh": "忙的時候吃泡麵，大家都吃過，不是壞事。"
            },
            {
              "who": "@npc",
              "zh": "可是芋頭和魚，要有人種、有人捕，才不會斷掉。你們自己想想。"
            }
          ],
          "actor": [
            "m",
            "f"
          ],
          "gives": {
            "flags": [
              "modern_noodles"
            ],
            "relation": 1,
            "toast": [
              "糧倉",
              "泡麵和田裡的芋頭，都在現在的餐桌上。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "椰油",
        "zh": "椰油的雜貨店老闆說，泡麵是店裡賣最好的東西。"
      },
      "playable": true
    },
    {
