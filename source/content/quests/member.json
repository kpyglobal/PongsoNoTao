        "season": "當地非飛魚季",
        "pre": "J1",
        "unlock": "織布學習卡（只畫簡單的背帶織布機，不畫織紋與禮衣）",
        "kind": "季節"
      },
      "req": "J1",
      "steps": [
        {
          "kind": "talk",
          "npc": "@hostf",
          "actor": [
            "f"
          ],
          "text": "族女在簷廊看婦女長輩織一小段布",
          "lines": [
            {
              "who": "@npc",
              "zh": "這是背帶織布機，腰靠著這條帶子，線就拉緊了。你先看就好。"
            },
            {
              "who": "旁白",
              "zh": "織布有一些禁忌，例如喪忌期間不碰織布機、男子不跨過織布機。這裡只用旁白說明，遊戲不會讓你去做。"
            },
            {
              "who": "旁白",
              "zh": "織紋與禮衣不在這裡呈現，等族人校對後再決定。"
            }
          ],
          "gives": {
            "flags": [
              "weaving_card"
            ],
            "toast": [
              "織布學習卡",
              "已寫進手札。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "婦女長輩",
        "zh": "苧麻曬好了，族女可以來簷廊看看織布。"
      },
      "playable": true,
      "giver": "f"
    },
