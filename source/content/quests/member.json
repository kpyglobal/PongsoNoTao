  "quests": [
    {
      "id": "J1",
      "line": "side",
      "arc": "member",
      "village": null,
      "name": {
        "zh": "跟婦女長輩處理苧麻：剝皮、浸泡、曬乾",
        "en": ""
      },
      "time": "day",
      "seasons": [
        "winter"
      ],
      "roles": [
        "f"
      ],
      "n": 1,
      "text": {
        "who": "族女",
        "coop": "單人（NPC 婦女長輩）",
        "season": "當地非飛魚季",
        "pre": "R3",
        "unlock": "苧麻圖鑑、J2",
        "kind": "季節"
      },
      "req": "R3",
      "steps": [
        {
          "kind": "talk",
          "npc": "@giver",
          "actor": [
            "f"
          ],
          "text": "族女向女性長輩接下工作：去簷廊幫忙處理苧麻",
          "lines": [
            {
              "who": "@npc",
              "zh": "苧麻收回來了，要剝皮、浸泡、曬乾。族女去簷廊幫婦女長輩，這要忙一陣子。"
            },
            {
              "who": "@npc",
              "zh": "其他人先去忙別的，等一下帶水過去幫她。"
            }
          ],
          "split": {
            "f": {
              "at": "host_weave",
              "task": "在簷廊處理苧麻",
              "ctrl": false
            }
          }
        },
        {
          "kind": "talk",
          "npc": "shop_yayo",
          "actor": [
            "m",
            "t"
          ],
          "text": "族男或旅人先到椰油的雜貨店買飲水，帶去簷廊",
          "lines": [
            {
              "who": "@npc",
              "zh": "要帶水去給在簷廊忙的人？拿去吧。"
            }
          ],
          "gives": {
            "items": [
              "water"
            ]
          }
        },
        {
          "kind": "talk",
          "npc": "@hostf",
          "actor": [
            "m",
            "t"
          ],
          "need": [
            "f"
          ],
          "regroup": true,
          "text": "帶水到簷廊，幫忙把苧麻收好，接族女回隊",
          "lines": [
            {
              "who": "@npc",
              "zh": "來，苧麻的皮這樣剝下來，泡在水裡，再拿去曬乾。"
            },
            {
              "who": "@f",
              "zh": "有你們幫忙快多了！原來要這麼多步驟，才會變成可以織的線。"
            },
            {
              "who": "旁白",
              "zh": "依文獻記載，飛魚汛期婦女不織布，所以這件事在非飛魚季才做；各部落細節還要請族人確認。"
            }
          ],
          "gives": {
            "flags": [
              "ramie_card"
            ],
            "toast": [
              "苧麻圖鑑",
              "已寫進手札。族女回到隊上了。"
            ]
          }
        },
        {
          "kind": "talk",
          "npc": "@giver",
          "actor": [
            "f"
          ],
          "text": "族女向女性長輩回報：苧麻處理好了",
          "lines": [
            {
              "who": "@npc",
              "zh": "苧麻都處理好了？做得很好，大家一起幫忙就快了。"
            }
          ]
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "主人家",
        "zh": "女性長輩在找族女幫忙處理苧麻；族女會留在簷廊，其他人要帶水去幫她。"
      },
      "playable": true,
      "giver": "f"
    },
    {
      "id": "J2",
      "line": "side",
