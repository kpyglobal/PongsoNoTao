          "npc": "shop_yayo",
          "actor": [
            "m",
            "t"
          ],
          "text": "族男或旅人先到椰油的雜貨店買飲水，帶去簷廊",
          "lines": [
            {
              "who": "@npc",
              "zh": "要帶水去給在簷廊忙的人？拿去吧。"
            }
          ],
          "gives": {
            "items": [
              "water"
            ]
