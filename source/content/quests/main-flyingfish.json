            "m"
          ],
          "minigame": "fish",
          "canoe": true,
          "text": "族男划拼板舟出海，看準飛魚躍出的時機（失敗可再試，或放棄出海）",
          "lines": [
            {
              "who": "@m",
              "zh": "捕到了！划回岸邊。"
            }
          ],
          "gives": {
            "items": [
