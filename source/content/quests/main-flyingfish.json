          "lines": [
            {
              "who": "@npc",
              "zh": "飛魚季到了，跟船組出海。這趟只有你去，其他人在岸邊等。"
            },
            {
              "who": "@npc",
              "zh": "穿上家裡織的衣服再來。上船出海，是很重要的事。"
            },
            {
              "who": "@npc",
              "zh": "看準時機，不行就回來，不要逞強。"
            },
            {
              "who": "旁白",
              "zh": "依傳統，飛魚季出海捕魚由男子負責。遊戲裡只做時機練習；真正的漁團與規矩還要請族人確認。"
            },
            {
              "who": "旁白",
              "zh": "出海期間只能操控族男。捕到魚，或按「放棄出海」，才會回岸邊和大家會合。"
            }
          ],
          "solo": {
            "role": "m",
            "at": "harbor",
            "task": "出海捕飛魚",
            "waitAt": "harbor"
          }
        },
