      "line": "main",
      "arc": "main",
      "village": null,
      "name": {
        "zh": "準備拼板舟與漁具",
        "en": ""
      },
      "time": "day",
      "seasons": [],
      "roles": [
        "m"
      ],
      "n": 1,
      "text": {
        "who": "族男",
        "coop": "單人（NPC 船組陪同）",
        "season": "等待飛魚期尾聲",
        "pre": "Q05",
        "unlock": "M3",
        "kind": ""
      },
      "req": "Q05",
      "steps": [
        {
          "kind": "talk",
          "npc": "@giver",
          "actor": [
            "m"
          ],
          "text": "族男向男性長輩接下工作：準備拼板舟與漁具",
          "lines": [
            {
              "who": "@npc",
              "zh": "飛魚季快到了，船和漁具要先整理好。跟著船組的人去港邊看看。"
            },
            {
              "who": "旁白",
              "zh": "船組怎麼分工、哪些事只有船組的人能做，還要請族人確認。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "harbor",
          "r": 8,
          "actor": [
            "m"
          ],
          "text": "族男到開元港邊，跟船組一起整理拼板舟與漁具",
          "lines": [
            {
              "who": "@m",
              "zh": "船身擦乾淨，漁網一段一段檢查，破的地方記下來。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "@giver",
          "actor": [
            "m"
          ],
          "text": "族男向男性長輩回報：船和漁具整理好了",
          "lines": [
            {
              "who": "@npc",
              "zh": "整理好了就好，等飛魚季開始。"
            }
          ]
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "主人家",
        "zh": "男性長輩要族男去港邊，跟船組整理拼板舟和漁具。"
      },
      "playable": true,
      "giver": "m"
    },
