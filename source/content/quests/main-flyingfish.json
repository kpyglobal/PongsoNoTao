    {
      "id": "M3",
      "line": "main",
      "arc": "main",
      "village": null,
      "name": {
        "zh": "出海捕飛魚",
        "en": ""
      },
      "time": "day",
      "seasons": [
        "summer"
      ],
      "roles": [
        "m"
      ],
      "n": 1,
      "text": {
        "who": "族男",
        "coop": "單人（NPC 船組陪同）",
        "season": "飛魚季（以當地部落為準）",
        "pre": "M1、M2（MS1 三人分頭準備為選做）",
        "unlock": "M4",
        "kind": "季節＋漁場（族男）"
      },
      "req": {
        "all": [
          "M1",
          "M2"
        ]
      },
      "steps": [
        {
          "kind": "talk",
          "npc": "@giver",
          "actor": [
            "m"
          ],
          "text": "族男向男性長輩接下出海的工作",
          "lines": [
            {
              "who": "@npc",
              "zh": "飛魚季到了，跟船組出海。這趟只有你去，其他人在岸邊等。"
            },
            {
              "who": "@npc",
              "zh": "看準時機，不行就回來，不要逞強。"
            },
            {
              "who": "旁白",
              "zh": "依傳統，飛魚季出海捕魚由男子負責。遊戲裡只做時機練習；真正的漁團與規矩還要請族人確認。"
            },
            {
              "who": "旁白",
              "zh": "出海期間只能操控族男。捕到魚，或按「放棄出海」，才會回岸邊和大家會合。"
            }
          ],
          "solo": {
            "role": "m",
            "at": "harbor",
            "task": "出海捕飛魚",
            "waitAt": "harbor"
          }
        },
        {
          "kind": "spot",
          "spot": "harbor",
          "r": 8,
          "actor": [
            "m"
          ],
          "minigame": "fish",
          "canoe": true,
          "text": "族男划拼板舟出海，看準飛魚躍出的時機（失敗可再試，或放棄出海）",
          "lines": [
            {
              "who": "@m",
              "zh": "捕到了！划回岸邊。"
            }
          ],
          "gives": {
            "items": [
              "alibangbang"
            ]
          }
        },
        {
          "kind": "spot",
          "spot": "harbor",
          "r": 10,
          "actor": [
            "m"
          ],
          "need": [
            "m",
            "f",
            "t"
          ],
          "regroup": true,
          "text": "族男回到岸邊，和族女、旅人會合",
          "lines": [
            {
              "who": "@f",
              "zh": "回來了！平安就好。"
            },
            {
              "who": "@t",
              "zh": "辛苦了！我們在岸邊一直看著。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "@giver",
          "actor": [
            "m"
          ],
          "text": "族男向男性長輩回報：平安回來了",
          "lines": [
            {
              "who": "@npc",
              "zh": "平安回來最重要。漁獲怎麼分，下次再教你。"
            }
          ]
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "主人家",
        "zh": "飛魚季時，男性長輩會叫族男出海；只有族男能去，其他人在岸邊等。"
      },
      "playable": true,
      "ground": "fishing",
      "giver": "m",
      "abortTo": 0
