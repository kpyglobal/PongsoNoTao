        "season": "全年（白天）",
        "pre": "Q07（島上的規矩）",
        "unlock": "與小旅客的約定",
        "kind": "小故事"
      },
      "req": "Q07",
      "steps": [
        {
          "kind": "talk",
          "npc": "kid_quest_tourist",
          "text": "和東清的小旅客聊聊",
          "lines": [
            {
              "who": "@npc",
              "zh": "我用望遠鏡看到海邊有好漂亮的船！我可以坐上去拍照嗎？"
            },
            {
              "who": "@me",
              "zh": "那是族人的拼板舟，不能隨便摸，也不能坐上去。我們一起去遠遠看。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "iranmeylek_beach",
          "r": 8,
          "text": "到東清灣沙灘，遠遠看灘頭上的拼板舟",
          "lines": [
            {
              "who": "旁白",
              "zh": "灘頭上的拼板舟，是一家人和船組一起做出來的。遠遠看、不靠近、不碰觸，是對船和主人的尊重。"
            },
            {
              "who": "@me",
              "zh": "用望遠鏡看就好，連船上的花紋都看得很清楚。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "kid_quest_tourist",
          "text": "回去告訴小旅客",
          "lines": [
            {
              "who": "@npc",
              "zh": "我知道了！只用望遠鏡看，不去摸它。我也會跟爸爸媽媽說。"
            }
          ],
          "gives": {
            "relation": 1,
            "toast": [
              "小旅客的望遠鏡",
              "你們陪小旅客遠遠欣賞拼板舟。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "東清",
        "zh": "東清有個拿著望遠鏡的小旅客，好像對海邊的船很好奇。"
      },
      "playable": true,
      "review": [
        "拼板舟禮儀（遠看、不碰、不坐上去拍照）的說法請族人確認；飛魚季期間外人是否連沙灘都不宜靠近也請確認"
      ]
    },
