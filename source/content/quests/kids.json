        {
          "kind": "spot",
          "spot": "iratay_shore",
          "r": 7,
          "text": "退潮時到漁人灘頭，陪女孩觀察寄居蟹",
          "lines": [
            {
              "who": "旁白",
              "zh": "只看不帶走：空貝殼可能是寄居蟹的家，翻過的石頭要放回原來的地方。"
            },
            {
              "who": "@me",
              "zh": "找到了！牠背著貝殼慢慢走。我們看就好。"
            }
