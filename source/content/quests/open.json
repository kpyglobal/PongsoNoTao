          "lines": [
            {
              "who": "@npc",
              "zh": "要租機車嗎？一台給你們，三個人輪流騎都可以。"
            },
            {
              "who": "@npc",
              "zh": "環島公路晚上要騎慢一點，路上常有陸蟹過馬路。"
            }
          ],
          "gives": {
            "flags": [
              "has_scooter"
            ],
            "toast": [
              "機車租好了",
              "全隊都能騎。按「機車」或 M 鍵切換。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "族人",
        "zh": "開元港旁邊就有租車行，老闆就站在店門口。"
      },
      "playable": true
    },
    {
      "id": "Q03",
      "line": "main",
      "arc": "open",
      "village": null,
      "name": {
        "zh": "回家報到",
        "en": ""
      },
      "time": "any",
      "seasons": [],
      "roles": [
        "m",
        "f"
      ],
      "n": 1,
      "text": {
        "who": "族男、族女",
        "coop": "單人",
        "season": "全年",
        "pre": "Q01",
        "unlock": "主人家庭、糧倉、R1",
        "kind": ""
      },
      "req": "Q01",
      "steps": [
        {
          "kind": "talk",
          "npc": "@host",
          "actor": [
            "m",
            "f"
          ],
          "text": "族男或族女回到家鄉部落，向主人家長輩報到",
          "lines": [
            {
              "who": "@npc",
              "zh": "回來啦！路上累了吧？"
            },
            {
              "who": "@npc",
              "zh": "家裡都準備好了，你們的朋友也一起住下來。糧倉在屋子旁邊，以後一起照顧。"
            }
          ],
          "gives": {
            "flags": [
              "host_family",
              "granary"
            ],
            "toast": [
              "回家報到",
              "主人家庭與糧倉已加入手札。"
            ]
          }
        },
        {
          "kind": "spot",
          "spot": "host_tagakal",
          "r": 5,
          "text": "長輩帶大家到家旁的涼亭坐一坐",
          "lines": [
            {
              "who": "@host",
              "zh": "來，上涼亭坐，鞋子脫在下面。這裡涼，看得到海。"
            },
            {
              "who": "@host",
              "zh": "你們小時候，就是在這裡聽我們說話長大的。"
            },
            {
              "who": "@me",
              "zh": "在台灣的時候，常常想起這個涼亭。這次回來，想把家裡的事好好學起來。"
            },
            {
              "who": "@host",
              "zh": "好。回家不是只回來看看，是回來記得。慢慢來，有事就到涼亭找我。"
            }
          ],
          "actor": [
            "m",
            "f"
          ],
          "gives": {
            "glossary": [
              "tagakal"
            ],
            "toast": [
              "主人家的涼亭",
              "主人家的涼亭是大家的家。以後在這裡聊天、聽故事。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "族人",
        "zh": "由族男或族女回家鄉部落，找主人家的長輩。"
      },
      "playable": true
    },
