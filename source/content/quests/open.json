    {
      "id": "Q07",
      "line": "main",
      "arc": "open",
      "village": null,
      "name": {
        "zh": "聽主人家長輩說明島上的規矩",
        "en": ""
      },
      "time": "any",
      "seasons": [],
      "roles": [
        "m",
        "f",
        "t"
      ],
      "n": 3,
      "need": [
        "m",
        "f",
        "t"
      ],
      "text": {
        "who": "全隊",
        "coop": "三人：全隊在主人家屋",
        "season": "全年",
        "pre": "Q03 且 Q04",
        "unlock": "尊重事件開始計分、手札規矩頁",
        "kind": "AND"
      },
      "req": {
        "all": [
          "Q03",
          "Q04"
        ]
      },
      "steps": [
        {
          "kind": "talk",
          "npc": "@host",
          "need": [
            "m",
            "f",
            "t"
          ],
          "text": "全隊到主人家，長輩請三個人分頭去辦事",
          "lines": [
            {
              "who": "@npc",
              "zh": "大家都到了。晚上我來說說島上的規矩，先請你們分頭去辦幾件事。"
            },
            {
              "who": "@npc",
              "zh": "族男去開元港，問問拼板舟漁人最近海上的情形；族女去簷廊，幫婦女長輩收東西；旅人去椰油的雜貨店，買晚上要用的東西。"
            },
            {
              "who": "@npc",
              "zh": "辦完就回家旁的涼亭集合，三個人到齊了我再說。"
            },
            {
              "who": "旁白",
              "zh": "隊伍分頭行動：點左上角頭像切換隊員，鏡頭會跳到那位隊員所在的地方。"
            }
          ],
          "split": {
            "m": {
              "at": "harbor",
              "task": "到開元港找拼板舟漁人",
              "ctrl": true
            },
            "f": {
              "at": "host_weave",
              "task": "到簷廊幫婦女長輩",
              "ctrl": true
            },
            "t": {
              "at": "yayo_shop",
              "task": "到椰油的雜貨店買東西",
              "ctrl": true
            }
          },
          "meet": "host_tagakal"
        },
        {
          "kind": "tasks",
          "text": "三人分頭辦事（族男：開元港／族女：簷廊／旅人：雜貨店）",
          "tasks": [
            {
              "role": "m",
              "kind": "talk",
              "npc": "villager_harbor",
              "text": "族男到開元港，向拼板舟漁人問候",
              "lines": [
                {
                  "who": "@npc",
                  "zh": "主人家的長輩叫你來的？最近風浪還可以。出海的事，等季節到了再說。"
                },
                {
                  "who": "@m",
                  "zh": "好，我回去跟長輩說。"
                }
              ]
            },
            {
              "role": "f",
              "kind": "talk",
              "npc": "@hostf",
              "text": "族女到簷廊，幫婦女長輩把東西收進來",
              "lines": [
                {
                  "who": "@npc",
                  "zh": "來得正好，幫我把曬在外面的東西收進來。"
                },
                {
                  "who": "@f",
                  "zh": "收好了，我先回主人家。"
                }
              ]
            },
            {
              "role": "t",
              "kind": "talk",
              "npc": "shop_yayo",
              "text": "旅人到椰油的雜貨店，買晚上要用的飲水",
              "lines": [
                {
                  "who": "@npc",
                  "zh": "要買飲水？好，這些拿去。路上小心。"
                },
                {
                  "who": "@t",
                  "zh": "謝謝！我拿回主人家。"
                }
              ],
              "gives": {
                "items": [
                  "water"
                ]
              }
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "host_tagakal",
          "r": 6,
          "need": [
            "m",
            "f",
            "t"
          ],
          "regroup": true,
          "text": "三人回到主人家的涼亭集合",
          "lines": [
            {
              "who": "@f",
              "zh": "大家都回來了，上涼亭坐吧。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "host_tagakal",
          "r": 6,
          "need": [
            "m",
            "f",
            "t"
          ],
          "text": "全隊坐在主人家的涼亭上，聽長輩說明島上的規矩",
          "lines": [
            {
              "who": "@host",
              "zh": "大家都到了，我說說島上的規矩。"
            },
            {
              "who": "@host",
              "zh": "飛魚季的時候，灘頭和拼板舟有很多規矩。旅人不要進灘頭，也不要碰船。"
            },
            {
              "who": "@host",
              "zh": "女孩子在飛魚季不碰拼板舟、不上船。"
            },
            {
              "who": "@host",
              "zh": "部落的祭儀不要靠近，也不要拍。想拍人或家屋，先問一聲。"
            },
            {
              "who": "@host",
              "zh": "曬魚架上的魚，是一家人一整年的糧食，不要隨便碰。"
            },
            {
              "who": "@host",
              "zh": "每個家庭、每個部落做法不太一樣，不懂就問。"
            }
          ],
          "gives": {
            "flags": [
              "rules_page",
              "respect_scoring"
            ],
            "toast": [
              "規矩頁",
              "手札加上「島上的規矩」，尊重事件開始計分。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "主人家",
        "zh": "回報到、導覽都完成後，三個人一起到主人家旁的涼亭找長輩。"
      },
      "playable": true,
      "song": "s08"
    },
