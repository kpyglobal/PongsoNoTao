    {
      "id": "Q01",
      "line": "main",
      "arc": "open",
      "village": null,
      "name": {
        "zh": "抵達蘭嶼",
        "en": ""
      },
      "time": "any",
      "seasons": [],
      "roles": [
        "m",
        "f",
        "t"
      ],
      "n": 3,
      "need": [
        "m",
        "f",
        "t"
      ],
      "text": {
        "who": "全隊",
        "coop": "三人：全隊一起入島",
        "season": "遊戲開始",
        "pre": "建立隊伍、選好怎麼前往蘭嶼",
        "unlock": "文化聲明、Q02、Q03、Q04",
        "kind": "開場紀錄：抵達動畫之後自動完成，顯示在任務清單，不是可再接的任務"
      },
      "req": {
        "flag": "party_created"
      },
      "steps": [
        {
          "kind": "auto",
          "text": "全隊一起抵達蘭嶼",
          "lines": [
            {
              "who": "文化聲明",
              "zh": "遊戲中呈現的男女分工、禁忌與飲食規範，以達悟族傳統文化中的一般性做法為設計起點，不代表所有家庭、部落或時代都完全如此。"
            },
            {
              "who": "文化聲明",
              "zh": "各部落在祭儀時程、禁忌細節與飲食習慣上各有差異，現代家庭的分工也已有許多變化。遊戲中不模擬祭儀本身，只呈現族人同意公開的飲食與生活面向。"
            },
            {
              "who": "@m",
              "zh": "到了！船靠岸了。這裡就是開元港。",
              "if": "arrived_boat"
            },
            {
              "who": "@m",
              "zh": "到了！飛機平安落地，這裡就是蘭嶼機場。",
              "if": "arrived_plane"
            },
            {
              "who": "@f",
              "zh": "好久沒回來了。小時候放暑假才回來，後來在台灣念書、工作，一年回不了一次。"
            },
            {
              "who": "@m",
              "zh": "這次要待久一點。長輩說，家裡的事、海上的事，要回來才學得到。"
            },
            {
              "who": "@f",
              "zh": "先去港口旁的租車行租機車，再回家跟家人報到吧。",
              "if": "arrived_boat"
            },
            {
              "who": "@f",
              "zh": "開元港旁邊有租車行，我們沿著環島公路走過去，租好機車再回家跟家人報到吧。",
              "if": "arrived_plane"
            },
            {
              "who": "@t",
              "zh": "好期待！你們帶路，我跟著走。"
            }
          ]
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "族人",
        "zh": "全隊已經一起上島了。"
      },
      "playable": false,
      "silent": false
    },
