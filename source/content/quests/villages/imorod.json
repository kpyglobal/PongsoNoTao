            "f"
          ],
          "text": "紅頭的織布長輩請族女幫忙捲線",
          "lines": [
            {
              "who": "@npc",
              "zh": "妳處理過苧麻了，現在來學捲線。線捲得好，布才織得平。"
            },
            {
              "who": "@npc",
              "zh": "飛魚季的時候我們不織布，所以冬天要多做一點。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "imorod",
          "r": 6,
          "actor": [
            "f"
          ],
          "text": "族女在紅頭的簷廊下，把苧麻線一圈一圈捲好",
          "lines": [
            {
              "who": "@f",
              "zh": "一圈、兩圈……手要放鬆，線才不會斷。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "weaver_elder",
          "actor": [
            "f"
          ],
          "text": "把捲好的線交給織布長輩",
          "lines": [
            {
              "who": "@npc",
              "zh": "捲得很漂亮。這一捲給妳留著，以後用得到。"
            }
          ],
          "gives": {
            "items": [
              "ramie_thread"
            ],
            "relation": 1
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "紅頭",
        "zh": "冬天紅頭的織布長輩需要人幫忙捲苧麻線。"
