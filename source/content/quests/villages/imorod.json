          "npc": "elder_imorod",
          "actor": [
            "m"
          ],
          "text": "紅頭的長輩要族男一起上山看羊",
          "lines": [
            {
              "who": "@npc",
              "zh": "山上的事，男人要懂。今天上去看看我們家的羊（kagling）。",
              "tao": "kagling"
            },
            {
              "who": "@npc",
              "zh": "每家的羊，耳朵上的記號不一樣。不是自己家的，不要碰。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "hongtoushan",
          "r": 10,
          "actor": [
            "m"
          ],
          "text": "族男跟長輩上紅頭山，數一數山坡上的羊",
          "lines": [
            {
              "who": "@m",
              "zh": "一、二、三……耳朵缺一角的是我們家的，總共五隻。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "elder_imorod",
          "actor": [
            "m"
          ],
          "text": "向紅頭的長輩回報",
          "lines": [
            {
              "who": "@npc",
              "zh": "五隻，對。以後羊走丟了，你就知道去哪裡找。"
            }
          ],
          "gives": {
            "relation": 1,
            "flags": [
              "saw_goats"
            ]
          }
        }
