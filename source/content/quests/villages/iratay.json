            "m"
          ],
          "text": "族男向漁人的長輩領出海的工作",
          "lines": [
            {
              "who": "@npc",
              "zh": "聽說你在椰油出過海了。今天跟我們漁人的船組出去，一樣，只有你去。"
            },
            {
              "who": "@npc",
              "zh": "海況不好就回來，沒有人會笑你。"
            },
            {
              "who": "旁白",
              "zh": "出海期間只能操控族男，族女與旅人在漁人灘頭等。捕到魚，或按「放棄出海」，才會回來會合。"
            }
          ],
          "solo": {
            "role": "m",
            "at": "iratay_shore",
            "task": "跟漁人的船組出海",
            "waitAt": "iratay_shore",
            "giveUp": [
              {
                "who": "elder_iratay",
                "zh": "回來了？好，平安最重要。下次再出去。"
              }
            ]
          }
        },
        {
          "kind": "spot",
          "spot": "iratay_shore",
          "r": 8,
          "actor": [
            "m"
          ],
          "minigame": "fish",
          "canoe": true,
          "text": "族男划拼板舟出海，看準飛魚躍出的時機（失敗可再試，或放棄出海）",
          "lines": [
            {
              "who": "@m",
              "zh": "捕到了！划回去。"
            }
          ],
          "gives": {
            "items": [
              "alibangbang",
              "alibangbang"
            ]
          }
        },
        {
          "kind": "spot",
          "spot": "iratay_shore",
          "r": 10,
          "actor": [
            "m"
          ],
          "need": [
            "m",
            "f",
            "t"
          ],
          "regroup": true,
          "text": "族男回到漁人灘頭，和族女、旅人會合",
          "lines": [
            {
              "who": "@f",
              "zh": "回來了！"
            },
            {
              "who": "@t",
              "zh": "我們一直在這裡等，沒有靠近船。"
            }
          ]
        },
