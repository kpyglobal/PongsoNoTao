      "name": {
        "zh": "漁人的族人：從機場回來的阿嬤",
        "en": ""
      },
      "text": {
        "who": "任一人",
        "coop": "單人",
        "season": "全年",
        "pre": "K2",
        "unlock": "漁人族人的信任",
        "kind": "關鍵人物・現代生活"
      },
      "req": "K2",
      "steps": [
        {
          "kind": "talk",
          "npc": "villager_iratay",
          "text": "漁人的族人要去機場接媽媽",
          "lines": [
            {
              "who": "@npc",
              "zh": "我媽媽去臺灣的醫院檢查，今天坐飛機回來。島上沒有大醫院，看病要跑來跑去。"
            },
            {
              "who": "@npc",
              "zh": "可以幫我去機場提行李嗎？我還要先去準備車子。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "airport",
          "r": 9,
          "text": "到蘭嶼機場幫阿嬤提行李",
          "lines": [
            {
              "who": "@me",
              "zh": "阿嬤，行李給我拿就好！"
            },
            {
              "who": "旁白",
              "zh": "阿嬤笑著把醫院的資料袋交給你，請你拿去衛生所。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "clinic_nurse",
          "text": "把醫院的資料交給衛生所護理師",
          "lines": [
            {
              "who": "@npc",
              "zh": "謝謝，我們會照著臺灣醫院的建議，定期去家裡看阿嬤。"
            },
            {
              "who": "@npc",
              "zh": "島上的長輩看病不容易，大家互相幫忙很重要。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "villager_iratay",
          "text": "回報漁人的族人",
          "lines": [
            {
              "who": "@npc",
              "zh": "真的太謝謝你們了。我媽說，下次要煮地瓜給你們吃。"
            }
          ],
          "gives": {
            "relation": 1,
            "flags": [
              "it_grandma"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "漁人",
        "zh": "漁人的族人要去機場接剛看完病回來的媽媽。"
      }
