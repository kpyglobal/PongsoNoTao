          "npc": "elder_f_iratay",
          "text": "向漁人的女性長輩回報",
          "lines": [
            {
              "who": "@npc",
              "zh": "辛苦了，這些拿去。以後要地瓜，先跟我說一聲，就可以來田裡挖。"
            }
          ],
          "gives": {
