      "name": {
        "zh": "東清的女性長輩：退潮時只拿需要的",
        "en": ""
      },
      "tide": "low",
      "review": [
        "東清潮間帶的採集規矩"
      ],
      "text": {
        "who": "任一人",
        "coop": "單人",
        "season": "全年（退潮）",
        "pre": "K5",
        "unlock": "貝類、海菜、潮間帶規矩",
        "kind": "a akes・潮間帶"
      },
      "req": "K5",
      "steps": [
        {
          "kind": "talk",
          "npc": "elder_f_iranmeylek",
          "text": "東清的女性長輩帶你去潮間帶",
          "lines": [
            {
              "who": "@npc",
              "zh": "退潮了，跟我來。潮間帶是大家的廚房，要留給明天，也要留給別人。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "tide_iranmeylek",
          "r": 4,
          "text": "跟著長輩在潮間帶撿貝類、採海菜，太小的放回去",
          "lines": [
            {
              "who": "elder_f_iranmeylek",
              "zh": "這個太小了，放回去，讓牠再長大。"
            },
            {
              "who": "@me",
              "zh": "那這個呢？"
            },
            {
              "who": "elder_f_iranmeylek",
              "zh": "這個可以。夠吃就好，不要裝滿。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "elder_f_iranmeylek",
          "text": "回到東清的女性長輩身邊",
          "lines": [
            {
              "who": "@npc",
              "zh": "今天就這些，剛剛好。潮水要回來了，我們上去吧。"
            }
          ],
          "gives": {
            "items": [
              "shellfish",
              "seaweed"
            ],
            "relation": 1,
            "flags": [
              "tide_rules_im"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "東清",
        "zh": "退潮時，東清的女性長輩會去潮間帶，可以跟她學怎麼採。"
      }
    },
