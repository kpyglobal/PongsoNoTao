        "unlock": "東清族人的信任",
        "kind": "關鍵人物"
      },
      "req": "K5",
      "steps": [
        {
          "kind": "talk",
          "npc": "villager_iranmeylek",
          "text": "東清的族人說起看日出的遊客",
          "lines": [
            {
              "who": "@npc",
              "zh": "每天清晨，很多遊客來東清灣看日出。人多是好事，可是垃圾也多。"
            },
            {
              "who": "@npc",
              "zh": "還有人坐到拼板舟上拍照……那是別人家的船啊。可以幫我一起去海灣看看嗎？"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "iranmeylek_beach",
          "r": 8,
          "text": "到東清灣沙灘撿垃圾，客氣地請遊客離拼板舟遠一點",
          "lines": [
            {
              "who": "@me",
              "zh": "不好意思，這是族人的船，可以到旁邊拍嗎？謝謝！"
            },
            {
              "who": "旁白",
              "zh": "撿起了寶特瓶和塑膠袋。"
            }
          ]
        },
        {
          "kind": "talk",
          "npc": "villager_iranmeylek",
          "text": "回報東清的族人",
          "lines": [
            {
              "who": "@npc",
              "zh": "謝謝你們。我們不是不歡迎遊客，只是希望大家記得，這裡是有人住的地方。"
            }
          ],
          "gives": {
            "relation": 1,
            "flags": [
              "im_bay_clean"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "東清",
        "zh": "東清的族人在煩惱清晨看日出的遊客，去問問他怎麼了。"
      }
