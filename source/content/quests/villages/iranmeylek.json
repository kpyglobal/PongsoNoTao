      },
      "req": "IM-V1",
      "steps": [
        {
          "kind": "talk",
          "npc": "villager_iranmeylek",
          "text": "晚上在東清，聽族人說他為什麼回到島上",
          "lines": [
            {
              "who": "@npc",
              "zh": "我以前在臺北工作十幾年，每天坐捷運，看不到海。"
            },
            {
              "who": "@npc",
              "zh": "後來阿爸身體不好，我就回來了。現在開民宿、帶導覽，也跟長輩學出海。"
            },
            {
              "who": "@npc",
              "zh": "年輕人回來不容易，工作少。可是你看這片海，晚上這麼安靜，我就知道我選對了。"
            }
          ],
          "gives": {
            "relation": 1,
            "flags": [
              "im_story"
            ]
          }
        }
      ],
      "hint": {
        "tier": "vague",
        "from": "東清",
        "zh": "晚上東清的族人常在灣邊乘涼。"
      }
    }
