              {
                "item": "wakay",
                "min": 2
              }
            ]
          }
        },
        {
          "kind": "talk",
          "npc": "elder_f_yayo",
          "text": "把地瓜交給椰油的女性長輩",
          "lines": [
            {
              "who": "@npc",
              "zh": "好，放這裡。地瓜放乾燥的地方可以放比較久，飛魚乾要常拿出來看看。"
            },
            {
              "who": "@npc",
              "zh": "存糧剛好就好，不要多也不要少，多的就分給親戚。"
            }
          ],
          "gives": {
