          "kind": "talk",
          "npc": "teacher_yayo",
          "text": "白天到椰油的學校找族語老師",
          "textEn": "Go to the Yayo school in the daytime to find the Tao language teacher",
          "lines": [
            {
              "who": "@npc",
              "zh": "你們好，我在這裡的學校教族語。",
              "en": "Hello. I teach Tao at the school here."
            },
            {
              "who": "@npc",
              "zh": "聽到長輩說的族語，不懂的話就記下來，帶來問我。學會的詞會寫進手札的族語詞卡。",
              "en": "If you hear the elders speak Tao and don't understand, write it down and bring it to me. Words you learn go onto the Tao word cards in your notebook."
            }
          ],
          "gives": {
            "flags": [
              "vocab_page"
            ],
            "toast": [
              "族語詞卡",
              "手札的「族語詞卡」可以開始收集了。"
            ],
            "toastEn": [
              "Tao word cards",
              "You can start collecting \"Tao word cards\" in your notebook."
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "租車行老闆",
        "fromEn": "Scooter rental owner",
        "zh": "族語老師白天在椰油的學校。",
        "en": "The Tao language teacher is at the Yayo school in the daytime."
