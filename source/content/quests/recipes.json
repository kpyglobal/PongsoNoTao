      ],
      "n": 1,
      "text": {
        "who": "任一人",
        "coop": "單人",
        "season": "全年",
        "pre": "K6（認識野銀的人）",
        "unlock": "料理卡「水煮芋頭」",
        "kind": "食譜"
      },
      "req": "K6",
      "steps": [
        {
          "kind": "talk",
          "npc": "villager_taro",
          "text": "向野銀的女性長輩請教「水煮芋頭」",
          "lines": [
            {
              "who": "@npc",
              "zh": "想學水煮芋頭？好啊，先把材料準備好：水芋三顆。"
            },
            {
              "who": "@npc",
              "zh": "材料齊了再拿來，我做給你們看。"
            },
            {
              "who": "旁白",
              "zh": "這道菜的做法與規矩，各家各部落不太一樣，細節還要請族人確認。"
            }
          ]
        },
        {
          "kind": "auto",
          "text": "收集食材：水芋三顆",
          "until": {
            "all": [
              {
                "item": "soli",
                "min": 3
              }
            ]
          }
        },
        {
          "kind": "talk",
          "npc": "villager_taro",
          "text": "把食材帶回去給野銀的女性長輩，學會「水煮芋頭」",
          "lines": [
            {
              "who": "@npc",
              "zh": "材料都齊了，你們看好。"
            },
            {
              "who": "@npc",
              "zh": "這就是水煮芋頭。洗乾淨，水煮就好，最簡單，也最常吃。其他做法改天再問家裡的長輩。"
            },
            {
              "who": "旁白",
              "zh": "料理卡已收進手札「食材與營養」。調味與分食的規矩還要請族人確認。"
            }
          ],
          "gives": {
            "recipe": "rc-boiled-taro",
            "consume": {
              "soli": 3
            },
            "relation": 1,
            "toast": [
              "學會食譜",
              "料理卡「水煮芋頭」已收進手札。"
            ]
          }
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "野銀",
        "zh": "野銀有位會做水煮芋頭的長輩，備齊三顆水芋再去找她。"
