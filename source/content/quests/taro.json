      "steps": [
        {
          "kind": "talk",
          "npc": "@giver",
          "actor": [
            "m"
          ],
          "text": "向女性長輩接下工作：開墾、整地、引水",
          "lines": [
            {
              "who": "@npc",
              "zh": "田要重新整理：開墾、整地、把水引進來，就交給你了。做好了回來跟我說。"
            }
          ]
        },
        {
          "kind": "spot",
          "spot": "host_taro",
          "r": 8,
          "actor": [
            "m"
          ],
          "text": "族男到主人家的水芋田，幫忙開墾、整地、引水",
          "lines": [
            {
              "who": "@m",
              "zh": "先把田裡的雜石搬開，再把水道清乾淨，讓山上的水流進田裡。"
            },
            {
              "who": "旁白",
              "zh": "依文獻記載，開墾水芋田多由男子負責，種植、除草與採收多由女子負責；各家做法不同，細節還要請族人確認。"
            }
          ],
          "gives": {
            "flags": [
              "taro_field_ready"
            ]
          }
        },
        {
          "kind": "talk",
          "npc": "@giver",
          "actor": [
            "m"
          ],
          "text": "向女性長輩回報：開墾、整地、引水",
          "lines": [
            {
              "who": "@npc",
              "zh": "田整理好了？我看過了，做得很好。"
            }
          ]
        }
      ],
      "hint": {
        "tier": "direct",
        "from": "主人家",
        "zh": "主人家的水芋田要先整地、引水，請族男去幫忙。"
      },
      "playable": true,
      "giver": "f"
    },
