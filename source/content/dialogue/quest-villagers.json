{
  "note": "東清、漁人的關鍵人物（K5 / K2 與後續 IM-V、IT-V 任務）。after：完成某任務後改說的話。",
  "dialogues": {
    "dlg_villager_iranmeylek": {
      "npc": "villager_iranmeylek",
      "greet": [
        {
          "zh": "嘿，你們好！來東清玩嗎？"
        }
      ],
      "duty": [
        {
          "zh": "我開民宿、帶導覽，也跟長輩學出海。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "早上的東清灣人最多，中午就安靜了。"
            },
            {
              "zh": "帶導覽的時候，我都先講規矩，再講風景。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上的灣邊最舒服，風吹著，什麼都不用想。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "飛魚季的時候，我會提醒客人不要進灘頭。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "winter"
            ]
          },
          "lines": [
            {
              "zh": "冬天遊客少，正好整理房子，也陪陪阿爸。"
            }
          ]
        }
      ],
      "after": {
        "IM-V1": [
          {
            "zh": "海灣乾淨多了，謝謝你們。"
          }
        ],
        "IM-V2": [
          {
            "zh": "那天晚上說了好多，你們不要笑我。"
          }
        ]
      }
    },
    "dlg_villager_iratay": {
      "npc": "villager_iratay",
      "greet": [
        {
          "zh": "你們好！要去機場嗎？順路的話我載你們。"
        }
      ],
      "duty": [
        {
          "zh": "我在漁人做小生意，也照顧家裡的長輩。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "飛機又誤點了，風太大。島上的人都習慣了。"
            },
            {
              "zh": "我媽每次去臺灣看病，我都要請假陪她。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "學校操場晚上很熱鬧，孩子們在練唱歌。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "夏天遊客多，生意比較好，可是也比較累。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "winter"
            ]
          },
          "lines": [
            {
              "zh": "冬天船常常停駛，東西都要先買好。"
            }
          ]
        }
      ],
      "after": {
        "IT-V1": [
          {
            "zh": "我媽一直說你們很有禮貌。"
          }
        ],
        "IT-V2": [
          {
            "zh": "晚會記得來喔！"
          }
        ],
        "NT4": [
          {
            "zh": "昨天的晚會好玩吧？孩子們唱得很好聽。"
          }
        ]
      }
    }
  }
}
