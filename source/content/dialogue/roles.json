{
  "note": "四位新增的職務 NPC（醫師、營養師、文化工作者、地質學家）的閒聊台詞；他們的任務仍是佔位。",
  "dialogues": {
    "dlg_clinic_doctor": {
      "npc": "clinic_doctor",
      "greet": [
        {
          "zh": "你好，哪裡不舒服嗎？"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "下水前先看海況，身體不舒服就不要下去。"
            },
            {
              "zh": "島上沒有大醫院，小傷也要好好處理。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上有急事，先打衛生所的電話。"
            }
          ]
        }
      ]
    },
    "dlg_nutritionist": {
      "npc": "nutritionist",
      "greet": [
        {
          "zh": "嗨！想聊聊吃什麼嗎？"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "芋頭、地瓜、飛魚，搭配起來營養很完整。"
            },
            {
              "zh": "泡麵方便，可是不能天天吃喔。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚餐吃清淡一點，明天比較有精神。"
            }
          ]
        }
      ]
    },
    "dlg_culture_worker": {
      "npc": "culture_worker",
      "greet": [
        {
          "zh": "akokey！來，坐一下。",
          "tao": "akokey"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "想認識部落，先學會問：可以嗎？"
            },
            {
              "zh": "有些地方是聖地，遠遠看就好。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上部落裡的故事，要長輩願意說，才可以聽。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "飛魚季的灘頭，訪客不要進去。"
            }
          ]
        }
      ]
    },
    "dlg_geologist": {
      "npc": "geologist",
      "greet": [
        {
          "zh": "哦，你好！你看這塊石頭——"
        },
        {
          "zh": "抱歉，我太興奮了。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "蘭嶼是火山島，這些黑色的岩石都是很久以前的熔岩。"
            },
            {
              "zh": "海浪把岩石切成各種形狀，族人也給它們取了名字。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上我就整理白天的筆記。"
            }
          ]
        }
      ]
    }
  }
}
