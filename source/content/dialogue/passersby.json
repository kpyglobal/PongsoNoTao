{
  "note": "路人（非族人的遊客）與小孩的閒聊。路人只講自己的旅行與禮貌，不替族人說明文化。",
  "dialogues": {
    "dlg_pb_couple": {
      "greet": [
        {
          "zh": "嗨！你們也是來玩的嗎？"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "民宿老闆說，灘頭上的船不能碰，我們就遠遠拍。"
            },
            {
              "zh": "東清灣的海好藍，看多久都不膩。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上的星星好多，城市裡根本看不到。"
            }
          ]
        }
      ]
    },
    "dlg_pb_tour": {
      "greet": [
        {
          "zh": "哎呀，你好你好！"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "導遊說進部落要放低音量，拍人之前要先問。"
            },
            {
              "zh": "等一下要去買紀念品，你知道哪裡有雜貨店嗎？"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "跟團跑了一整天，腳好痠。"
            }
          ]
        }
      ]
    },
    "dlg_pb_retiree": {
      "greet": [
        {
          "zh": "年輕人好啊。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "退休了，終於有時間慢慢走。這裡的路沿著海，走起來很舒服。"
            },
            {
              "zh": "我們不趕行程，看到什麼就停下來看。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "早點休息，明天想去看日出。"
            }
          ]
        }
      ]
    },
    "dlg_pb_backpacker": {
      "greet": [
        {
          "zh": "Hi！你好！"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "我在學中文，也在學一點點族語的問候。"
            },
            {
              "zh": "我把垃圾都帶走，島上的垃圾很難處理。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "今天走了好遠，明天再去另一邊。"
            }
          ]
        }
      ]
    },
    "dlg_pb_family": {
      "greet": [
        {
          "zh": "你好！"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "孩子第一次來蘭嶼，一直問東問西。"
            },
            {
              "zh": "防曬、帽子、水都帶了，海邊太陽很大。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "孩子玩累了，今天會很好睡。"
            }
          ]
        }
      ]
    },
    "dlg_kid_tourist_girl": {
      "greet": [
        {
          "zh": "你看！我的小水桶！"
        }
      ],
      "idle": [
        {
          "lines": [
            {
              "zh": "媽媽說海邊的東西只能看，不能帶回家。"
            }
          ]
        }
      ],
      "npc": "kid_tourist_girl"
    },
    "dlg_kid_local_ball": {
      "greet": [
        {
          "zh": "要一起踢球嗎？"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "放學以後我都在這裡踢球。"
            },
            {
              "zh": "球不要踢到人家的田裡，阿嬤會生氣。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "天黑了，我要回家吃飯了。"
            }
          ]
        }
      ],
      "npc": "kid_local_ball"
    },
    "dlg_kid_quest_tourist": {
      "greet": [
        {
          "zh": "哥哥姊姊好！"
        }
      ],
      "idle": [
        {
          "lines": [
            {
              "zh": "我的望遠鏡可以看好遠喔！"
            }
          ]
        }
      ],
      "after": {
        "KD1": [
          {
            "zh": "我回去跟爸爸媽媽說了：拼板舟要遠遠看，不能摸。"
          }
        ]
      },
      "npc": "kid_quest_tourist"
    },
    "dlg_kid_quest_local": {
      "greet": [
        {
          "zh": "你們好。"
        }
      ],
      "idle": [
        {
          "lines": [
            {
              "zh": "我喜歡畫海邊的東西，貝殼、螃蟹、石頭都畫。"
            }
          ]
        }
      ],
      "after": {
        "KD2": [
          {
            "zh": "寄居蟹的畫我會帶去學校給老師看。"
          }
        ]
      },
      "npc": "kid_quest_local"
    }
  }
}
