{
  "note": "女性長輩 a akes：帶領生產（水芋、食物、紡織）；每位也是該部落的食譜傳承者（keeper 區塊：invite / missing / teach / after，{need} 由程式代入缺少的食材）。",
  "dialogues": {
    "dlg_elder_f_yayo": {
      "npc": "elder_f_yayo",
      "greet": [
        {
          "zh": "akokey！來，坐一下。",
          "tao": "akokey"
        }
      ],
      "duty": [
        {
          "zh": "家裡吃什麼、存多少，椰油這邊我在管。"
        },
        {
          "zh": "煮東西、保存東西，都是女人的功夫。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "今天太陽好，東西拿出來曬一曬。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚飯吃了嗎？沒吃的話，鍋子裡還有芋頭。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "飛魚曬好了要收好，那是一整年的糧食。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "winter"
            ]
          },
          "lines": [
            {
              "zh": "冬天的存糧要省著吃。"
            }
          ]
        }
      ],
      "keeper": {
        "invite": [
          {
            "zh": "想學飛魚乾嗎？飛魚季的時候帶飛魚來，我教你怎麼處理。"
          }
        ],
        "missing": [
          {
            "zh": "材料還不夠：{need}。找齊了再來。"
          }
        ],
        "teach": [
          {
            "zh": "這就是飛魚乾。曬好收起來，冬天也有魚吃。"
          },
          {
            "zh": "每一家做法不太一樣，細節還要請族人確認。"
          }
        ],
        "after": [
          {
            "zh": "飛魚乾記得常拿出來看看，不要讓它受潮。"
          }
        ]
      }
    },
    "dlg_elder_f_iraraley": {
      "npc": "elder_f_iraraley",
      "greet": [
        {
          "zh": "akokey！來，坐一下。",
          "tao": "akokey"
        }
      ],
      "duty": [
        {
          "zh": "朗島的田地，山藥、小米，我在照顧。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "田裡的草又長出來了。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上田裡不去，明天一早再去。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "小米長得很好，今年應該會豐收。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "winter"
            ]
          },
          "lines": [
            {
              "zh": "冬天種下去的東西，要等春天才看得到。"
            }
          ]
        }
      ],
      "keeper": {
        "invite": [
          {
            "zh": "想學水煮山藥？去山邊採兩根山藥來。"
          }
        ],
        "missing": [
          {
            "zh": "材料還不夠：{need}。找齊了再來。"
          }
        ],
        "teach": [
          {
            "zh": "山藥去皮，水煮，就這麼簡單。滑滑的，好消化。"
          },
          {
            "zh": "每一家做法不太一樣，細節還要請族人確認。"
          }
        ],
        "after": [
          {
            "zh": "山藥要挑對地方採，不要把整片都挖光。"
          }
        ]
      }
    },
    "dlg_elder_f_iranmeylek": {
      "npc": "elder_f_iranmeylek",
      "greet": [
        {
          "zh": "akokey！來，坐一下。",
          "tao": "akokey"
        }
      ],
      "duty": [
        {
          "zh": "東清的潮間帶，我從小走到大。什麼能撿、什麼不能撿，問我。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "今天什麼時候退潮？看一下潮汐。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上退潮也可以去看看，可是要帶燈，小心腳下。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "夏天的海很溫柔，潮間帶的東西也多。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "winter"
            ]
          },
          "lines": [
            {
              "zh": "冬天浪大，潮間帶不要去太外面。"
            }
          ]
        }
      ],
      "keeper": {
        "invite": [
          {
            "zh": "想學水煮貝類與海菜？退潮時去撿兩個貝類、採兩把海菜。"
          }
        ],
        "missing": [
          {
            "zh": "材料還不夠：{need}。找齊了再來。"
          }
        ],
        "teach": [
          {
            "zh": "洗乾淨，水煮，配芋頭或地瓜。這就是海的味道。"
          },
          {
            "zh": "每一家做法不太一樣，細節還要請族人確認。"
          }
        ],
        "after": [
          {
            "zh": "記得，太小的放回去，讓牠長大。"
          }
        ]
      }
    },
    "dlg_villager_taro": {
      "npc": "villager_taro",
      "greet": [
        {
          "zh": "akokey！來，坐一下。",
          "tao": "akokey"
        }
      ],
      "duty": [
        {
          "zh": "野銀的水芋田是我在顧的。水要流、草要拔，芋頭才會好。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "soli 長得好不好，看葉子就知道。",
              "tao": "soli"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "天黑了，田裡的水聲聽得特別清楚。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "飛魚季，男人出海，田裡就更要顧好。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "winter"
            ]
          },
          "lines": [
            {
              "zh": "冬天田裡的水比較冷，手腳要動快一點。"
            }
          ]
        }
      ],
      "keeper": {
        "invite": [
          {
            "zh": "想學水煮芋頭？採三顆水芋來。"
          }
        ],
        "missing": [
          {
            "zh": "材料還不夠：{need}。找齊了再來。"
          }
        ],
        "teach": [
          {
            "zh": "洗乾淨，水煮。最簡單，也最常吃。"
          },
          {
            "zh": "每一家做法不太一樣，細節還要請族人確認。"
          }
        ],
        "after": [
          {
            "zh": "吃飽了才有力氣做事。"
          }
        ]
      }
    },
    "dlg_weaver_elder": {
      "npc": "weaver_elder",
      "greet": [
        {
          "zh": "akokey！來，坐一下。",
          "tao": "akokey"
        }
      ],
      "duty": [
        {
          "zh": "織布是紅頭的女人一代一代傳下來的。能公開的部分，我慢慢教。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "光線好的時候，織布最清楚。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上眼睛不好，不織了。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "飛魚季的時候，我們不織布。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "winter"
            ]
          },
          "lines": [
            {
              "zh": "冬天正好織布，一坐就是一個下午。"
            }
          ]
        }
      ],
      "keeper": {
        "invite": [
          {
            "zh": "想學水煮飛魚？飛魚季的時候帶兩條飛魚來。"
          }
        ],
        "missing": [
          {
            "zh": "材料還不夠：{need}。找齊了再來。"
          }
        ],
        "teach": [
          {
            "zh": "飛魚水煮，調味簡單。有些東西不能跟飛魚一起煮，這是規矩。"
          },
          {
            "zh": "每一家做法不太一樣，細節還要請族人確認。"
          }
        ],
        "after": [
          {
            "zh": "飛魚的規矩要記住，那是飛魚教我們的。"
          }
        ]
      }
    },
    "dlg_elder_f_iratay": {
      "npc": "elder_f_iratay",
      "greet": [
        {
          "zh": "akokey！來，坐一下。",
          "tao": "akokey"
        }
      ],
      "duty": [
        {
          "zh": "漁人的地瓜田和水芋田，我在照顧。"
        },
        {
          "zh": "要田裡的東西，先問一聲。"
        }
      ],
      "idle": [
        {
          "when": {
            "time": "day"
          },
          "lines": [
            {
              "zh": "地瓜不挑地，好種又耐放。"
            }
          ]
        },
        {
          "when": {
            "time": "night"
          },
          "lines": [
            {
              "zh": "晚上學校那邊有時候很熱鬧，孩子在練唱歌。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "summer"
            ]
          },
          "lines": [
            {
              "zh": "夏天太陽大，下田要戴斗笠。"
            }
          ]
        },
        {
          "when": {
            "seasons": [
              "winter"
            ]
          },
          "lines": [
            {
              "zh": "冬天的地瓜特別甜。"
            }
          ]
        }
      ],
      "keeper": {
        "invite": [
          {
            "zh": "想學芋頭與地瓜？帶一顆水芋、一顆地瓜來。"
          }
        ],
        "missing": [
          {
            "zh": "材料還不夠：{need}。找齊了再來。"
          }
        ],
        "teach": [
          {
            "zh": "兩個分開水煮，一起當飯吃。簡單，但是很飽。"
          },
          {
            "zh": "每一家做法不太一樣，細節還要請族人確認。"
          }
        ],
        "after": [
          {
            "zh": "田裡挖的東西，記得分一點給鄰居。"
          }
        ]
      }
    }
  }
}
