  "hints": [
    {
      "id": "h-words",
      "teaser": "有些話，只有老師聽得懂…",
      "body": "長輩有時只用族語說話。把聽見的帶回學校，或許老師會請你再幫一個忙。"
    },
    {
      "id": "h-table",
      "teaser": "衛生所隔壁，還有人在聽島上的飯桌。",
      "body": "第一次坐下來聊天的人，也許會多問一句：這陣子家裡都吃些什麼。"
    },
    {
      "id": "h-tide",
      "teaser": "退潮來得準的時候，岸邊會留下很安靜的故事。",
      "body": "若連續幾次都剛好趕上海水退下，潮池裡有些生命只適合看，不適合帶走。"
    },
    {
      "id": "h-wall",
      "teaser": "照片多了，學校的走廊好像缺了一點什麼。",
      "body": "旅人走得夠遠、拍得夠真心時，也許可以把島的樣子，借一角牆壁給別人看。"
    },
    {
      "id": "h-stone",
      "teaser": "跟石頭走在一起的人，筆記本裡好像還有沒寫完的一頁。",
      "body": "海岸被海寫過的痕跡，不是一次就能看完。"
    }
  ],
